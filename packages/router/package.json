{
  "name": "@codenexus/router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "pnpm exec eslint src scripts --ext .js,.ts,.mjs --max-warnings=0",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "pnpm exec tsc --noEmit --project tsconfig.json",
    "upstream:check": "node scripts/check-upstream.mjs"
  },
  "dependencies": {
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
